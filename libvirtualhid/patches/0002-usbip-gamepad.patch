+#if defined(__linux__)
+    constexpr auto dualsense_usbip_env = "LIBVIRTUALHID_DUALSENSE_USBIP";
+    constexpr auto vhci_sysfs_env = "LIBVIRTUALHID_VHCI_SYSFS";
+    constexpr auto dualsense_haptics_rtp_env = "LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP";
+    constexpr auto dualsense_haptics_gain_env = "LIBVIRTUALHID_DUALSENSE_HAPTICS_GAIN";
+    constexpr auto dualsense_haptics_gain_file_env = "LIBVIRTUALHID_DUALSENSE_HAPTICS_GAIN_FILE";
+    constexpr int usbip_attach_attempts = 3;
+    constexpr auto usbip_enumeration_timeout = std::chrono::seconds {2};
+    constexpr auto usbip_enumeration_poll_interval = std::chrono::milliseconds {10};
+    constexpr std::size_t usbip_output_queue_capacity = 256;
+    // Bus 1, device 1: the identifier vhci-hcd reports for the imported device.
+    constexpr std::uint32_t usbip_device_id = (1U << 16U) | 1U;
+
+    std::optional<std::string> environment_string(const char *name) {
+      const auto *value = std::getenv(name);
+      if (value == nullptr) {
+        return std::nullopt;
+      }
+      return std::string {value};
+    }
+
+    bool environment_equals(const char *name, std::string_view expected) {
+      const auto value = environment_string(name);
+      return value.has_value() && *value == expected;
+    }
+
+    std::optional<float> parse_float(const std::string &text) {
+      char *end = nullptr;
+      const auto value = std::strtof(text.c_str(), &end);
+      if (end == text.c_str() || *end != '\0' || !std::isfinite(value)) {
+        return std::nullopt;
+      }
+      return value;
+    }
+
+    /**
+     * @brief Write one line to the USB/IP library log, prefixed like every libvirtualhid diagnostic.
+     *
+     * @param message Message without trailing newline.
+     */
+    void usbip_log(std::string_view message) {
+      std::fprintf(stderr, "libvirtualhid: %.*s\n", static_cast<int>(message.size()), message.data());
+    }
+
+    /**
+     * @brief Read a whole small text file through the syscall wrappers.
+     *
+     * @param path File to read, such as the vhci-hcd status file.
+     * @return File content, or std::nullopt when it cannot be opened or read.
+     */
+    std::optional<std::string> read_text_file(const std::string &path) {
+      const auto fd = system_open(path.c_str(), O_RDONLY | O_CLOEXEC);
+      if (fd < 0) {
+        return std::nullopt;
+      }
+
+      std::string text;
+      std::array<std::byte, 256> buffer {};
+      while (true) {
+        const auto count = system_read(fd, buffer);
+        if (count == 0) {
+          break;
+        }
+        if (count < 0) {
+          if (errno == EINTR) {
+            continue;
+          }
+          static_cast<void>(system_close(fd));
+          return std::nullopt;
+        }
+        text.append(reinterpret_cast<const char *>(buffer.data()), static_cast<std::size_t>(count));
+      }
+      static_cast<void>(system_close(fd));
+      return text;
+    }
+
+    /**
+     * @brief Write a short text to a vhci-hcd control file ("attach" or "detach").
+     *
+     * @param path Control file to write.
+     * @param text Text to write, without trailing newline.
+     * @return 0 on success, otherwise the errno of the failing call.
+     */
+    int write_control_file(const std::string &path, const std::string &text) {
+      const auto fd = system_open(path.c_str(), O_WRONLY | O_CLOEXEC);
+      if (fd < 0) {
+        return errno;
+      }
+      const auto written = system_write(fd, std::as_bytes(std::span<const char> {text}));
+      const auto error = written == static_cast<std::ptrdiff_t>(text.size()) ? 0 : (written < 0 ? errno : EIO);
+      static_cast<void>(system_close(fd));
+      return error;
+    }
+
+    std::vector<std::string> directory_entry_names(const std::filesystem::path &directory) {
+      std::vector<std::string> names;
+      std::error_code error;
+      for (std::filesystem::directory_iterator it {directory, error}, end; !error && it != end; it.increment(error)) {
+        names.push_back(it->path().filename().string());
+      }
+      return names;
+    }
+
+    /**
+     * @brief Append the sysfs, hidraw and evdev/joystick nodes below one HID device directory.
+     *
+     * @param nodes Output list.
+     * @param hid_directory Directory named like 0003:054C:0CE6.NNNN.
+     */
+    void append_usbip_hid_nodes(std::vector<DeviceNode> &nodes, const std::filesystem::path &hid_directory) {
+      using enum DeviceNodeKind;
+
+      append_node(nodes, sysfs, hid_directory);
+      for (const auto &name : directory_entry_names(hid_directory / "hidraw")) {
+        if (name.starts_with("hidraw")) {
+          append_node(nodes, hidraw, std::filesystem::path {"/dev"} / name);
+        }
+      }
+      for (const auto &input : directory_entry_names(hid_directory / "input")) {
+        if (!input.starts_with("input")) {
+          continue;
+        }
+        for (const auto &name : directory_entry_names(hid_directory / "input" / input)) {
+          if (name.starts_with("event")) {
+            append_node(nodes, input_event, std::filesystem::path {"/dev/input"} / name);
+          } else if (name.starts_with("js")) {
+            append_node(nodes, joystick, std::filesystem::path {"/dev/input"} / name);
+          }
+        }
+      }
+    }
+
+    /**
+     * @brief Find the platform nodes of the DualSense attached at one vhci port.
+     *
+     * The device sits in the first high-speed root hub usbN as N-<port+1>, with its HID interface
+     * N-<port+1>:1.3 holding the 0003:* HID device directory.
+     *
+     * @param sysfs_root vhci-hcd sysfs directory.
+     * @param port vhci port number (0-based, as in the status file).
+     * @return Discovered nodes, or an empty list when nothing matches.
+     */
+    std::vector<DeviceNode> usbip_device_nodes(const std::filesystem::path &sysfs_root, int port) {
+      std::vector<DeviceNode> nodes;
+      for (const auto &name : directory_entry_names(sysfs_root)) {
+        if (!name.starts_with("usb")) {
+          continue;
+        }
+        const auto bus = name.substr(3);
+        if (bus.empty() || !std::ranges::all_of(bus, [](char digit) {
+              return digit >= '0' && digit <= '9';
+            })) {
+          continue;
+        }
+        if (read_first_line(sysfs_root / name / "speed") != std::string {"480"}) {
+          continue;
+        }
+
+        const auto interface_directory = sysfs_root / name / std::format("{}-{}", bus, port + 1) /
+                                         std::format("{}-{}:1.3", bus, port + 1);
+        for (const auto &hid_name : directory_entry_names(interface_directory)) {
+          if (hid_name.starts_with("0003:")) {
+            append_usbip_hid_nodes(nodes, interface_directory / hid_name);
+          }
+        }
+        return nodes;
+      }
+      return nodes;
+    }
+
+    /**
+     * @brief DualSense emulated over USB/IP and attached to the vhci-hcd kernel driver.
+     *
+     * A DualSenseDevice answers the requests of a UsbipSession whose socket is handed to vhci-hcd.
+     * Output reports are queued from the session threads and dispatched by one worker thread, so
+     * the output callback never runs on a session thread.
+     */
+    class UsbipGamepad final: public BackendGamepad {
+    public:
+      /**
+       * @brief Create an unattached gamepad for the USB DualSense profile.
+       *
+       * @param profile USB DualSense profile.
+       * @param mac Controller MAC address used by the pairing feature report.
+       */
+      UsbipGamepad(DeviceProfile profile, const std::array<std::uint8_t, 6> &mac):
+          profile_ {std::move(profile)},
+          playstation_mac_address_ {mac} {
+        last_report_[0] = ds5usbip::dualsense::kInputReportId;
+      }
+
+      UsbipGamepad(const UsbipGamepad &) = delete;
+      UsbipGamepad &operator=(const UsbipGamepad &) = delete;
+      UsbipGamepad(UsbipGamepad &&) noexcept = delete;
+      UsbipGamepad &operator=(UsbipGamepad &&) noexcept = delete;
+
+      /**
+       * @brief Destroy the gamepad, detaching it from vhci-hcd when it is attached.
+       */
+      ~UsbipGamepad() override {
+        static_cast<void>(close());
+      }
+
+      /**
+       * @brief Create the emulated DualSense and attach it to vhci-hcd.
+       *
+       * Every resource acquired before a failure is released, so the caller may fall back to uhid.
+       *
+       * @param id Runtime-assigned device id, used for the MAC address when stable_id is not a MAC.
+       * @param options Creation options; the profile must be the USB DualSense profile.
+       * @return Creation result. On failure, the status message is the reason for the fallback.
+       */
+      static BackendGamepadCreationResult create(DeviceId id, const CreateGamepadOptions &options) {
+        const auto sysfs_root = environment_string(vhci_sysfs_env).value_or(std::string {ds5usbip::vhci::kDefaultSysfs});
+        if (system_access((sysfs_root + "/attach").c_str(), W_OK) != 0) {
+          return {
+            OperationStatus::failure(ErrorCode::backend_unavailable, "vhci-hcd not loaded or attach not writable"),
+            nullptr,
+          };
+        }
+
+        const auto mac = parse_mac_address(options.metadata.stable_id).value_or(generated_mac_address(id));
+        auto gamepad = std::make_unique<UsbipGamepad>(options.profile, mac);
+        if (auto status = gamepad->start(sysfs_root); !status.ok()) {
+          static_cast<void>(gamepad->close());
+          return {std::move(status), nullptr};
+        }
+        return {OperationStatus::success(), std::move(gamepad)};
+      }
+
+      /**
+       * @brief Store the latest state and its packed report for the next USB IN polls.
+       *
+       * @param state Normalized gamepad state.
+       * @param report Packed 64-byte DualSense USB input report.
+       * @return Submit status.
+       */
+      OperationStatus submit(const GamepadState &state, const std::vector<std::uint8_t> &report) override {
+        using enum ErrorCode;
+
+        if (!open_) {
+          return OperationStatus::failure(device_closed, "USB/IP gamepad is closed");
+        }
+        if (peer_closed_) {
+          return OperationStatus::failure(device_closed, "vhci-hcd closed the USB/IP connection");
+        }
+        if (report.size() != ds5usbip::dualsense::kHidReportSize) {
+          return OperationStatus::failure(invalid_argument, "DualSense USB input report must be 64 bytes");
+        }
+
+        ds5usbip::DualSenseDevice::Report stored {};
+        std::copy(report.begin(), report.end(), stored.begin());
+        {
+          std::lock_guard lock {state_mutex_};
+          last_state_ = state;
+          last_report_ = stored;
+        }
+        device_->set_input_report(stored);
+        return OperationStatus::success();
+      }
+
+      /**
+       * @brief Register the callback that receives parsed output reports on the dispatcher thread.
+       *
+       * @param callback Output callback; an empty callback drops the outputs.
+       */
+      void set_output_callback(OutputCallback callback) override {
+        std::lock_guard lock {callback_mutex_};
+        output_callback_ = std::move(callback);
+      }
+
+      /**
+       * @brief Platform nodes of the attached DualSense, read from the vhci-hcd sysfs tree.
+       *
+       * @return Discovered nodes, or an empty list when the device is not attached or not yet visible.
+       */
+      std::vector<DeviceNode> device_nodes() const override {
+        if (!attached_port_) {
+          return {};
+        }
+        return usbip_device_nodes(sysfs_root_, *attached_port_);
+      }
+
+      /**
+       * @brief Detach from vhci-hcd, stop the USB/IP session and the output dispatcher.
+       *
+       * The detach write is best effort: closing the session also unplugs the device. Calling close()
+       * again has no effect.
+       *
+       * @return Close status.
+       */
+      OperationStatus close() override {
+        if (!open_.exchange(false)) {
+          return OperationStatus::success();
+        }
+
+        if (attached_port_) {
+          static_cast<void>(write_control_file(sysfs_root_ + "/detach", std::to_string(*attached_port_)));
+          attached_port_.reset();
+        }
+        if (session_) {
+          session_->stop();
+        }
+
+        std::size_t dropped = 0;
+        {
+          std::lock_guard lock {queue_mutex_};
+          output_queue_.clear();
+          dropped = std::exchange(dropped_output_reports_, 0);
+        }
+        if (dispatcher_.joinable()) {
+          dispatcher_.request_stop();
+          dispatcher_.join();
+        }
+        if (dropped != 0) {
+          usbip_log(std::format("dropped {} DualSense output reports while the queue was full", dropped));
+        }
+        haptics_.reset();
+        return OperationStatus::success();
+      }
+
+    private:
+      /**
+       * @brief Build the device, open the session, attach it and wait for enumeration.
+       *
+       * @param sysfs_root vhci-hcd sysfs directory.
+       * @return Start status; on failure the caller closes the gamepad.
+       */
+      OperationStatus start(std::string sysfs_root) {
+        sysfs_root_ = std::move(sysfs_root);
+
+        std::array<int, 2> pair {-1, -1};
+        if (::socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, pair.data()) != 0) {
+          return system_error_status(ErrorCode::backend_failure, "socketpair failed", errno);
+        }
+
+        device_ = std::make_unique<ds5usbip::DualSenseDevice>(make_device_config(), make_device_callbacks());
+        configure_haptics();
+
+        ds5usbip::UsbipSession::Callbacks callbacks;
+        callbacks.audio_out = [this](std::span<const std::uint8_t> pcm) {
+          if (haptics_) {
+            haptics_->send(pcm);
+          }
+        };
+        callbacks.closed = [this] {
+          peer_closed_ = true;
+        };
+        session_ = std::make_unique<ds5usbip::UsbipSession>(pair[0], *device_, std::move(callbacks), usbip_log);
+        if (!session_->start()) {
+          static_cast<void>(system_close(pair[1]));
+          return OperationStatus::failure(ErrorCode::backend_failure, "failed to start the USB/IP session");
+        }
+
+        const auto attach_status = attach(pair[1]);
+        static_cast<void>(system_close(pair[1]));  // vhci-hcd keeps its own reference
+        if (!attach_status.ok()) {
+          return attach_status;
+        }
+
+        if (const auto status = wait_for_enumeration(); !status.ok()) {
+          return status;
+        }
+
+        dispatcher_ = std::jthread {[this](std::stop_token stop_token) {
+          dispatch_loop(stop_token);
+        }};
+        return OperationStatus::success();
+      }
+
+      /**
+       * @brief Write the attach line on a free high-speed port, retrying when the port is busy.
+       *
+       * @param kernel_fd Kernel side of the socketpair; vhci-hcd takes its own reference.
+       * @return Attach status; the attached port is remembered on success.
+       */
+      OperationStatus attach(int kernel_fd) {
+        const auto status_path = sysfs_root_ + "/status";
+        const auto attach_path = sysfs_root_ + "/attach";
+        std::vector<int> busy_ports;
+        for (int attempt = 0; attempt < usbip_attach_attempts; ++attempt) {
+          const auto status_text = read_text_file(status_path);
+          if (!status_text) {
+            return OperationStatus::failure(ErrorCode::backend_unavailable, "vhci-hcd status is unreadable");
+          }
+
+          const auto port = ds5usbip::vhci::pick_free_port(ds5usbip::vhci::parse_status(*status_text), busy_ports);
+          if (!port) {
+            return OperationStatus::failure(ErrorCode::backend_unavailable, "no free high-speed vhci port");
+          }
+
+          const auto line = ds5usbip::vhci::attach_line(
+            *port,
+            kernel_fd,
+            usbip_device_id,
+            static_cast<int>(ds5usbip::usbip::kSpeedHigh)
+          );
+          const auto error = write_control_file(attach_path, line);
+          if (error == 0) {
+            attached_port_ = *port;
+            return OperationStatus::success();
+          }
+          if (error != EBUSY) {
+            return system_error_status(ErrorCode::backend_failure, "attach write failed", error);
+          }
+          busy_ports.push_back(*port);
+        }
+        return OperationStatus::failure(ErrorCode::backend_unavailable, "vhci-hcd ports stayed busy");
+      }
+
+      /**
+       * @brief Poll until the host has set the configuration of the emulated device.
+       *
+       * @return Success once configured; failure on timeout or when the peer closed the connection.
+       */
+      OperationStatus wait_for_enumeration() {
+        const auto deadline = std::chrono::steady_clock::now() + usbip_enumeration_timeout;
+        while (!device_->configured()) {
+          if (peer_closed_) {
+            return OperationStatus::failure(ErrorCode::backend_failure, "vhci-hcd closed the connection before enumeration");
+          }
+          if (std::chrono::steady_clock::now() >= deadline) {
+            return OperationStatus::failure(ErrorCode::backend_failure, "enumeration timeout");
+          }
+          std::this_thread::sleep_for(usbip_enumeration_poll_interval);
+        }
+        return OperationStatus::success();
+      }
+
+      /**
+       * @brief Create the RTP haptics sender when LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP is set.
+       */
+      void configure_haptics() {
+        const auto destination = environment_string(dualsense_haptics_rtp_env);
+        if (!destination) {
+          return;
+        }
+
+        auto sender = std::make_unique<ds5usbip::HapticsRtpSender>(usbip_log);
+        if (!sender->set_destination(*destination)) {
+          usbip_log(std::format("haptics disabled, invalid destination {}", *destination));
+          return;
+        }
+
+        auto gain = 1.0F;
+        if (const auto gain_text = environment_string(dualsense_haptics_gain_env)) {
+          if (const auto parsed = parse_float(*gain_text)) {
+            gain = *parsed;
+          } else {
+            usbip_log(std::format("invalid haptics gain {}, using 1", *gain_text));
+          }
+        }
+        sender->set_gain(gain, environment_string(dualsense_haptics_gain_file_env).value_or(std::string {}));
+        haptics_ = std::move(sender);
+      }
+
+      ds5usbip::DeviceConfig make_device_config() {
+        ds5usbip::DeviceConfig config;
+        config.hid_report_descriptor = std::span<const std::uint8_t> {profile_.report_descriptor};
+        config.get_feature = [profile = profile_, mac = playstation_mac_address_](std::uint8_t report_number) {
+          return playstation_feature_report(profile, mac, report_number);
+        };
+        config.input_provider = [this] {
+          return current_input_report();
+        };
+        return config;
+      }
+
+      ds5usbip::DualSenseDevice::Callbacks make_device_callbacks() {
+        ds5usbip::DualSenseDevice::Callbacks callbacks;
+        // SET_REPORT(feature) data already starts with its report id, so it is queued as is,
+        // as uhid's dispatch_set_report does for the same bytes.
+        callbacks.output_report = [this](std::span<const std::uint8_t> report) {
+          enqueue_output(report);
+        };
+        callbacks.feature_set = [this](std::span<const std::uint8_t> report) {
+          enqueue_output(report);
+        };
+        return callbacks;
+      }
+
+      /**
+       * @brief Input report for one HID IN poll, packed from the latest state.
+       *
+       * DualSense reports carry a sequence number and a timestamp, so the report is packed on every poll.
+       * When the packed size is unexpected, the last submitted report is returned.
+       *
+       * @return 64-byte input report.
+       */
+      ds5usbip::DualSenseDevice::Report current_input_report() {
+        GamepadState state;
+        ds5usbip::DualSenseDevice::Report report {};
+        {
+          std::lock_guard lock {state_mutex_};
+          state = last_state_;
+          report = last_report_;
+        }
+
+        const auto packed = reports::pack_input_report(profile_, state);
+        if (packed.size() == report.size()) {
+          std::copy(packed.begin(), packed.end(), report.begin());
+        }
+        return report;
+      }
+
+      /**
+       * @brief Queue one output report, dropping the oldest one when the queue is full.
+       *
+       * @param report Raw report bytes, report id first.
+       */
+      void enqueue_output(std::span<const std::uint8_t> report) {
+        std::lock_guard lock {queue_mutex_};
+        if (output_queue_.size() >= usbip_output_queue_capacity) {
+          output_queue_.pop_front();
+          ++dropped_output_reports_;
+        }
