+    };
+
+    const auto descriptor = control_in({0x80, 0x06, 0x00, 0x02, 0x00, 0x00, 0x00, 0x02}, 512);
+    // HID descriptor embedded in the configuration descriptor: 09 21 11 01 00 01 22 <wDescriptorLength>.
+    constexpr std::array<std::uint8_t, 7> hid_prefix {0x09, 0x21, 0x11, 0x01, 0x00, 0x01, 0x22};
+    const auto hid = std::search(descriptor.data.begin(), descriptor.data.end(), hid_prefix.begin(), hid_prefix.end());
+    if (hid != descriptor.data.end() && std::distance(hid, descriptor.data.end()) >= 9) {
+      result.hid_descriptor_length = static_cast<std::uint16_t>(hid[7] | (hid[8] << 8U));
+    }
+
+    const auto configured = peer_transact(peer_fd, seqnum, wire::kDirOut, 0, {0x00, 0x09, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00}, {}, 0);
+    result.configuration_set = configured.ok && configured.status == 0;
+    creator.join();
+    result.create_status = created.status;
+    if (!created) {
+      return result;
+    }
+
+    BackendGamepad &gamepad = *created.gamepad;
+    std::mutex records_mutex;
+
+    struct OutputRecord {
+      std::uint16_t low_frequency = 0;
+      std::thread::id thread;
+    };
+
+    std::vector<OutputRecord> records;
+    gamepad.set_output_callback([&records, &records_mutex](const GamepadOutput &output) {
+      if (output.kind == GamepadOutputKind::rumble) {
+        std::lock_guard lock {records_mutex};
+        records.push_back({output.low_frequency_rumble, std::this_thread::get_id()});
+      }
+    });
+
+    const auto pairing = control_in({0xA1, 0x01, 0x09, 0x03, 0x03, 0x00, 0x40, 0x00}, 64);
+    if (pairing.ok && pairing.data.size() >= result.pairing_prefix.size()) {
+      std::copy_n(pairing.data.begin(), result.pairing_prefix.size(), result.pairing_prefix.begin());
+    }
+
+    GamepadState state;
+    state.left_stick.x = 0.5F;
+    const auto expected = reports::pack_input_report(profiles::dualsense_usb(), state);
+    result.submit_status = gamepad.submit(state, expected);
+    const auto input = peer_transact(peer_fd, seqnum, wire::kDirIn, 4, {}, {}, 64);
+    // Masked comparison: the sequence number (byte 7) and the sensor timestamp (bytes 28-31) change per report.
+    result.input_report_matches = input.ok && input.data.size() == expected.size();
+    for (std::size_t index = 0; result.input_report_matches && index < expected.size(); ++index) {
+      const bool masked = index == 7 || (index >= 28 && index <= 31);
+      result.input_report_matches = masked || input.data[index] == expected[index];
+    }
+
+    constexpr std::size_t burst_size = 200;
+    std::size_t burst_sent = 0;
+    for (std::size_t index = 0; index < burst_size; ++index) {
+      std::array<std::uint8_t, 64> output {};
+      output[0] = 0x02;
+      output[1] = 0x01;  // valid_flag0: rumble
+      output[4] = static_cast<std::uint8_t>(index);  // left motor, one step per report
+      const auto reply = peer_transact(peer_fd, seqnum, wire::kDirOut, 3, {}, output, 0);
+      if (!reply.ok || reply.status != 0) {
+        break;
+      }
+      ++burst_sent;
+    }
+    result.burst_sent = burst_sent;
+
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds {2};
+    while (true) {
+      {
+        std::lock_guard lock {records_mutex};
+        if (records.size() >= burst_sent || std::chrono::steady_clock::now() >= deadline) {
+          break;
+        }
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds {1});
+    }
+
+    {
+      std::lock_guard lock {records_mutex};
+      result.burst_count = records.size();
+      result.burst_in_order = records.size() == burst_sent;
+      for (std::size_t index = 0; result.burst_in_order && index < records.size(); ++index) {
+        // Same scaling as the library's output parser: motor byte -> 16-bit rumble.
+        const auto expected_low = static_cast<std::uint16_t>(std::lround((static_cast<float>(index) / 255.0F) * 65535.0F));
+        result.burst_in_order = records[index].low_frequency == expected_low;
+      }
+      result.burst_on_caller_thread = std::ranges::any_of(records, [](const OutputRecord &record) {
+        return record.thread == std::this_thread::get_id();
+      });
+    }
+
+    result.close_status = gamepad.close();
+    result.peer_saw_eof_after_close = peer_saw_eof(peer_fd);
+    created.gamepad.reset();
+    {
+      std::lock_guard lock {probe.mutex};
+      result.detach_text = probe.detach_text;
+    }
+    return result;
+  }
