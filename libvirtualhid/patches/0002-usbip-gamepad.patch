+  /**
+   * @brief Run a callable with file descriptor 2 redirected to a temporary file and return what it wrote.
+   *
+   * BaseTest already captures stderr through gtest, which allows one capture at a time, so this redirects the descriptor directly.
+   */
+  template<typename Callable>
+  std::string capture_stderr_during(Callable &&callable) {
+    std::fflush(stderr);
+    std::FILE *captured = std::tmpfile();
+    if (captured == nullptr) {
+      callable();
+      return {};
+    }
+    const auto saved = ::dup(STDERR_FILENO);
+    static_cast<void>(::dup2(fileno(captured), STDERR_FILENO));
+    callable();
+    std::fflush(stderr);
+    static_cast<void>(::dup2(saved, STDERR_FILENO));
+    static_cast<void>(::close(saved));
+
+    std::string text;
+    std::array<char, 1024> buffer {};
+    std::rewind(captured);
+    std::size_t count = 0;
+    while ((count = std::fread(buffer.data(), 1, buffer.size(), captured)) > 0) {
+      text.append(buffer.data(), count);
+    }
+    static_cast<void>(std::fclose(captured));
+    return text;
+  }
