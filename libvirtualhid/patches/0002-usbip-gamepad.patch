+      namespace wire = ds5usbip::usbip;
+      UsbipPeerReply reply;
+
+      wire::Header request {};
+      request.base.command = wire::be32(wire::kCmdSubmit);
+      request.base.seqnum = wire::be32(++seqnum);
+      request.base.devid = wire::be32(usbip_test_devid);
+      request.base.direction = wire::be32(direction);
+      request.base.ep = wire::be32(endpoint);
+      request.u.cmd_submit.transfer_buffer_length = wire::be32s(out.empty() ? in_length : static_cast<std::int32_t>(out.size()));
+      std::memcpy(request.u.cmd_submit.setup, setup.data(), setup.size());
+      if (!peer_send_all(fd, &request, sizeof(request))) {
+        return reply;
+      }
+      if (direction == wire::kDirOut && !out.empty() && !peer_send_all(fd, out.data(), out.size())) {
+        return reply;
+      }
+
+      wire::Header response {};
+      if (!peer_recv_exact(fd, &response, sizeof(response))) {
+        return reply;
+      }
+      if (ntohl(response.base.command) != wire::kRetSubmit || ntohl(response.base.seqnum) != seqnum) {
+        return reply;
+      }
+      reply.status = static_cast<std::int32_t>(ntohl(response.u.ret_submit.status));
+      const auto actual = static_cast<std::int32_t>(ntohl(response.u.ret_submit.actual_length));
