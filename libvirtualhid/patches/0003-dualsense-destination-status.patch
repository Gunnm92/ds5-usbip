+    class ScopedTemporaryDirectory {
+    public:
+      ScopedTemporaryDirectory():
+          root_ {std::filesystem::temp_directory_path() / std::format("lvh-status-{}-{}", ::getpid(), std::random_device {}())} {
+        std::filesystem::create_directories(root_);
