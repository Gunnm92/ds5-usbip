+      /**
+       * @brief Track the peak level of each PCM channel over the current second, for the status file.
+       *
+       * Runs on the session audio thread: only lock-free atomics, no I/O. Levels are taken before the haptics gain.
+       *
+       * @param pcm One isochronous packet: S16_LE, four interleaved channels.
+       */
+      void record_peaks(std::span<const std::uint8_t> pcm) {
+        constexpr std::size_t frame_bytes = 8;
+        std::array<std::uint32_t, 4> peaks {};
+        for (std::size_t frame = 0; frame + frame_bytes <= pcm.size(); frame += frame_bytes) {
+          for (std::size_t channel = 0; channel < peaks.size(); ++channel) {
+            const auto sample = static_cast<std::int32_t>(static_cast<std::int16_t>(pcm[frame + 2 * channel] | (pcm[frame + 2 * channel + 1] << 8)));
+            peaks[channel] = std::max(peaks[channel], static_cast<std::uint32_t>(sample < 0 ? -sample : sample));
+          }
+        }
+        for (std::size_t channel = 0; channel < peaks.size(); ++channel) {
+          auto current = peak_levels_[channel].load(std::memory_order_relaxed);
+          while (peaks[channel] > current &&
+                 !peak_levels_[channel].compare_exchange_weak(current, peaks[channel], std::memory_order_relaxed)) {
+          }
+        }
+      }
+
+      /**
+       * @brief Start the status writer when LIBVIRTUALHID_DUALSENSE_STATUS is set.
+       *
+       * Called after enumeration, so the port, destination and channels are fixed before the thread starts.
+       */
+      void start_status_writer() {
+        const auto status_path = environment_string(dualsense_status_env).value_or(std::string {});
+        if (status_path.empty()) {
+          return;
+        }
+        status_path_ = status_path;
+        status_port_ = attached_port_.value_or(-1);
+        status_writer_ = std::jthread {[this](std::stop_token stop_token) {
+          status_loop(stop_token);
+        }};
+      }
+
+      /**
+       * @brief Write the status file now and then once per second until stop is requested.
+       *
+       * @param stop_token Stop request from close().
+       */
+      void status_loop(std::stop_token stop_token) {
+        write_status(true);
+        std::unique_lock lock {status_mutex_};
+        while (true) {
+          static_cast<void>(status_condition_.wait_for(lock, stop_token, usbip_status_interval, [&stop_token] {
+            return stop_token.stop_requested();
+          }));
+          if (stop_token.stop_requested()) {
+            return;
+          }
+          write_status(true);
+        }
+      }
+
+      /**
+       * @brief Stop the status writer and write the closing record, once.
+       */
+      void stop_status_writer() {
+        if (!status_writer_.joinable()) {
+          return;
+        }
+        status_writer_.request_stop();
+        status_writer_.join();
+        write_status(false);
+      }
+
+      /**
+       * @brief Write the status JSON atomically. Failures are ignored: the file is diagnostic only.
+       *
+       * Attached records consume the peak levels of the last second. With several gamepads, the last writer wins.
+       *
+       * @param attached true for the periodic record, false for the closing record.
+       */
+      void write_status(bool attached) {
+        const auto updated_ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+        std::string text;
+        if (attached) {
+          const auto gain = haptics_ ? haptics_->gain() : configured_gain_;
+          const auto packets = haptics_ ? haptics_->packets() : std::uint64_t {0};
+          std::string peaks;
+          for (std::size_t channel = 0; channel < peak_levels_.size(); ++channel) {
+            const auto peak = peak_levels_[channel].exchange(0, std::memory_order_relaxed);
+            const auto db = peak == 0 ? usbip_silence_db : 20.0F * std::log10(static_cast<float>(peak) / 32768.0F);
+            peaks += std::format("{}{:.1f}", channel == 0 ? "" : ",", db);
+          }
+          text = std::format(
+            R"({{"attached":true,"vhci_port":{},"destination":"{}","channels":{},"gain":{},"peak_db":[{}],"packets":{},"updated_ms":{}}})",
+            status_port_,
+            json_escape(haptics_destination_),
+            haptics_channels_,
+            gain,
+            peaks,
+            packets,
+            updated_ms
+          );
+        } else {
+          text = std::format(R"({{"attached":false,"updated_ms":{}}})", updated_ms);
+        }
+        static_cast<void>(ds5usbip::write_text_atomically(status_path_, text + "\n"));
+      }
