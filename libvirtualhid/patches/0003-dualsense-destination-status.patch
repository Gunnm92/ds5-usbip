+  LinuxUsbipStatusResult linux_usbip_gamepad_status(const LinuxUsbipStatusScenario &scenario) {
+    namespace wire = ds5usbip::usbip;
+    LinuxUsbipStatusResult result;
+    ScopedTemporaryDirectory directory;
+    const auto status_path = directory.path() / "status.json";
+    std::string settings_path;
+    if (scenario.settings_text) {
+      settings_path = (directory.path() / "settings.conf").string();
+      std::ofstream settings {settings_path};
+      settings << *scenario.settings_text;
+    }
+
+    ScopedVhciSysfs sysfs {std::string {usbip_status_header} + std::string {usbip_status_port0_busy} + "hs  0001 004 000 00000000 000000 0-0\n", true};
+    ScopedUsbipEnvironment environment {sysfs.path(), true};
+    ScopedEnvironmentVariable status_env {"LIBVIRTUALHID_DUALSENSE_STATUS", status_path.string()};
+    ScopedEnvironmentVariable settings_env {"LIBVIRTUALHID_DUALSENSE_SETTINGS", settings_path};
+    ScopedEnvironmentVariable destination_env {"LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP", scenario.env_destination};
+    ScopedEnvironmentVariable channels_env {"LIBVIRTUALHID_DUALSENSE_RTP_CHANNELS", scenario.env_channels};
+    ScopedEnvironmentVariable gain_env {"LIBVIRTUALHID_DUALSENSE_HAPTICS_GAIN", scenario.env_gain};
+    ScopedEnvironmentVariable gain_file_env {"LIBVIRTUALHID_DUALSENSE_HAPTICS_GAIN_FILE", {}};
+
+    UsbipAttachProbe probe;
+    LinuxTestSyscalls syscalls;
+    install_usbip_hooks(syscalls, probe);
+    ScopedLinuxTestSyscalls scoped_syscalls {syscalls};
+
+    CreateGamepadOptions options;
+    options.profile = profiles::dualsense_usb();
+    options.metadata.stable_id = "02:03:04:05:06:07";
+    options.metadata.haptics_destination = scenario.metadata_destination;
+
+    BackendGamepadCreationResult created;
+    std::jthread creator {[&created, &options] {
+      LinuxUhidBackend backend;
+      created = backend.create_gamepad(1, options);
+    }};
+
+    if (!wait_for_attach(probe)) {
+      creator.join();
+      result.create_status = created.status;
+      return result;
+    }
+    int peer_fd = -1;
+    {
+      std::lock_guard lock {probe.mutex};
+      peer_fd = probe.peer_fd;
+    }
+    std::uint32_t seqnum = 0;
+    const auto configured = peer_transact(peer_fd, seqnum, wire::kDirOut, 0, {0x00, 0x09, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00}, {}, 0);
+    static_cast<void>(configured);
+    creator.join();
+    result.create_status = created.status;
+    if (!created) {
+      return result;
+    }
+
+    wait_for_status_text(status_path, "\"attached\":true");
+    result.status_while_attached = read_whole_file(status_path);
+    static_cast<void>(created.gamepad->close());
+    result.status_after_close = read_whole_file(status_path);
+    created.gamepad.reset();
+    return result;
+  }
