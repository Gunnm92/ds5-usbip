+
+      ScopedTemporaryDirectory(const ScopedTemporaryDirectory &) = delete;
+      ScopedTemporaryDirectory &operator=(const ScopedTemporaryDirectory &) = delete;
+      ScopedTemporaryDirectory(ScopedTemporaryDirectory &&) noexcept = delete;
+      ScopedTemporaryDirectory &operator=(ScopedTemporaryDirectory &&) noexcept = delete;
+
+      ~ScopedTemporaryDirectory() {
+        std::error_code error;
+        std::filesystem::remove_all(root_, error);
+      }
+
+      const std::filesystem::path &path() const {
+        return root_;
+      }
+
+    private:
+      std::filesystem::path root_;
+    };
+
+    /**
+     * @brief Sets one environment variable for the scope; an empty value leaves it unset.
+     */
+    class ScopedEnvironmentVariable {
+    public:
+      ScopedEnvironmentVariable(const char *name, const std::string &value):
+          name_ {name} {
+        if (value.empty()) {
+          static_cast<void>(::unsetenv(name_));
+        } else {
+          static_cast<void>(::setenv(name_, value.c_str(), 1));
+        }
+      }
+
+      ScopedEnvironmentVariable(const ScopedEnvironmentVariable &) = delete;
+      ScopedEnvironmentVariable &operator=(const ScopedEnvironmentVariable &) = delete;
+      ScopedEnvironmentVariable(ScopedEnvironmentVariable &&) noexcept = delete;
+      ScopedEnvironmentVariable &operator=(ScopedEnvironmentVariable &&) noexcept = delete;
+
+      ~ScopedEnvironmentVariable() {
+        static_cast<void>(::unsetenv(name_));
+      }
+
+    private:
+      const char *name_;
+    };
+
+    std::string read_whole_file(const std::filesystem::path &path) {
+      std::ifstream input {path};
+      std::ostringstream text;
+      text << input.rdbuf();
+      return text.str();
+    }
+
+    /**
+     * @brief Poll the status file until it contains needle, for up to three seconds.
+     */
+    void wait_for_status_text(const std::filesystem::path &path, std::string_view needle) {
+      const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds {3};
+      while (std::chrono::steady_clock::now() < deadline) {
+        if (read_whole_file(path).find(needle) != std::string::npos) {
+          return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds {5});
+      }
+    }
