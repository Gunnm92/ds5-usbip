From ea4c8cd91fa86eba9c14eaf39a542d2ecde72955 Mon Sep 17 00:00:00 2001
From: Gunnm92 <gunnm44@gmail.com>
Date: Sun, 22 Nov 2026 18:44:27 +0100
Subject: [PATCH] refactor(linux): extract PlayStation feature report lookup

Move the DualSense and DualShock 4 feature-report table lookup, MAC
insertion, and Bluetooth CRC out of UhidGamepad::send_get_report_reply
into a free function in the Linux backend's anonymous namespace. The
produced bytes and error codes are unchanged.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 src/platform/linux/uhid_backend.cpp | 148 +++++++++++++++++-----------
 1 file changed, 90 insertions(+), 58 deletions(-)

diff --git a/src/platform/linux/uhid_backend.cpp b/src/platform/linux/uhid_backend.cpp
index 34d68e2..f72d0de 100644
--- a/src/platform/linux/uhid_backend.cpp
+++ b/src/platform/linux/uhid_backend.cpp
@@ -3142,6 +3142,83 @@ namespace lvh::detail {
     };
 
 #if defined(__linux__)
+    /**
+     * @brief Build the payload for a DualSense or DualShock 4 feature report.
+     *
+     * Pairing reports carry the controller MAC address in reversed byte order at offsets 1 through 6.
+     * Bluetooth profiles store the PlayStation feature-report CRC32 in the last four bytes.
+     *
+     * @param profile Gamepad profile that selects the report table and bus framing.
+     * @param mac Controller MAC address in the order used for the UHID unique identifier.
+     * @param report_number Feature report number requested by the host.
+     * @return Payload to send, or std::nullopt when the profile has no entry for the report number.
+     */
+    std::optional<std::vector<std::uint8_t>> playstation_feature_report(
+      const DeviceProfile &profile,
+      const std::array<std::uint8_t, 6> &mac,
+      std::uint8_t report_number
+    ) {
+      std::vector<std::uint8_t> payload;
+      const auto insert_reversed_mac = [&payload, &mac] {
+        for (std::size_t index = 0; index < mac.size(); ++index) {
+          payload[1U + index] = mac[mac.size() - 1U - index];
+        }
+      };
+
+      if (profile.gamepad_kind == GamepadProfileKind::dualshock4) {
+        switch (report_number) {
+          case ps::dualshock4_usb_calibration_report:
+            payload.assign(ps::dualshock4_usb_calibration_info.begin(), ps::dualshock4_usb_calibration_info.end());
+            break;
+          case ps::dualshock4_bluetooth_calibration_report:
+            if (profile.bus_type != BusType::bluetooth) {
+              return std::nullopt;
+            }
+            payload.assign(
+              ps::dualshock4_bluetooth_calibration_info.begin(),
+              ps::dualshock4_bluetooth_calibration_info.end()
+            );
+            break;
+          case ps::dualshock4_pairing_report:
+            payload.assign(ps::dualshock4_pairing_info.begin(), ps::dualshock4_pairing_info.end());
+            insert_reversed_mac();
+            break;
+          case ps::dualshock4_firmware_report:
+            payload.assign(ps::dualshock4_firmware_info.begin(), ps::dualshock4_firmware_info.end());
+            break;
+          default:
+            return std::nullopt;
+        }
+      } else if (profile.gamepad_kind == GamepadProfileKind::dualsense) {
+        switch (report_number) {
+          case ps::dualsense_calibration_report:
+            payload.assign(ps::dualsense_calibration_info.begin(), ps::dualsense_calibration_info.end());
+            break;
+          case ps::dualsense_pairing_report:
+            payload.assign(ps::dualsense_pairing_info.begin(), ps::dualsense_pairing_info.end());
+            insert_reversed_mac();
+            break;
+          case ps::dualsense_firmware_report:
+            payload.assign(ps::dualsense_firmware_info.begin(), ps::dualsense_firmware_info.end());
+            break;
+          default:
+            return std::nullopt;
+        }
+      } else {
+        return std::nullopt;
+      }
+
+      if (profile.bus_type == BusType::bluetooth && payload.size() >= 4U) {
+        const auto crc_offset = payload.size() - 4U;
+        const auto crc = crc32(
+          std::span<const std::uint8_t> {payload.data(), crc_offset},
+          playstation_crc_seed(ps::playstation_feature_crc_seed)
+        );
+        write_u32_le(payload.data() + crc_offset, crc);
+      }
+      return payload;
+    }
+
     /**
      * @brief Backend gamepad backed by one Linux UHID file descriptor.
      */
@@ -3510,73 +3587,28 @@ namespace lvh::detail {
         }
       }
 
+      /**
+       * @brief Answer a host GET_REPORT request with a PlayStation feature report or an error.
+       *
+       * @param id Request identifier echoed back to the kernel.
+       * @param report_number Feature report number requested by the host.
+       */
       void send_get_report_reply(std::uint32_t id, std::uint8_t report_number) {
         uhid_event event {};
         event.type = UHID_GET_REPORT_REPLY;
         event.u.get_report_reply.id = id;
         event.u.get_report_reply.err = EIO;
 
-        if (profile_.gamepad_kind == GamepadProfileKind::dualshock4) {
-          event.u.get_report_reply.err = 0;
-          switch (report_number) {
-            case ps::dualshock4_usb_calibration_report:
-              copy_get_report_payload(event, ps::dualshock4_usb_calibration_info);
-              break;
-            case ps::dualshock4_bluetooth_calibration_report:
-              if (profile_.bus_type == BusType::bluetooth) {
-                copy_get_report_payload(event, ps::dualshock4_bluetooth_calibration_info);
-                break;
-              }
-              event.u.get_report_reply.err = EINVAL;
-              break;
-            case ps::dualshock4_pairing_report:
-              copy_get_report_payload(event, ps::dualshock4_pairing_info);
-              for (std::size_t index = 0; index < playstation_mac_address_.size(); ++index) {
-                event.u.get_report_reply.data[1U + index] =
-                  playstation_mac_address_[playstation_mac_address_.size() - 1U - index];
-              }
-              break;
-            case ps::dualshock4_firmware_report:
-              copy_get_report_payload(event, ps::dualshock4_firmware_info);
-              break;
-            default:
-              event.u.get_report_reply.err = EINVAL;
-              break;
-          }
-        } else if (profile_.gamepad_kind == GamepadProfileKind::dualsense) {
-          event.u.get_report_reply.err = 0;
-          switch (report_number) {
-            case ps::dualsense_calibration_report:
-              copy_get_report_payload(event, ps::dualsense_calibration_info);
-              break;
-            case ps::dualsense_pairing_report:
-              copy_get_report_payload(event, ps::dualsense_pairing_info);
-              for (std::size_t index = 0; index < playstation_mac_address_.size(); ++index) {
-                event.u.get_report_reply.data[1U + index] =
-                  playstation_mac_address_[playstation_mac_address_.size() - 1U - index];
-              }
-              break;
-            case ps::dualsense_firmware_report:
-              copy_get_report_payload(event, ps::dualsense_firmware_info);
-              break;
-            default:
-              event.u.get_report_reply.err = EINVAL;
-              break;
+        if (is_playstation_profile(profile_.gamepad_kind)) {
+          const auto payload = playstation_feature_report(profile_, playstation_mac_address_, report_number);
+          if (payload.has_value()) {
+            event.u.get_report_reply.err = 0;
+            copy_get_report_payload(event, *payload);
+          } else {
+            event.u.get_report_reply.err = EINVAL;
           }
         }
 
-        if (
-          profile_.bus_type == BusType::bluetooth && is_playstation_profile(profile_.gamepad_kind) &&
-          event.u.get_report_reply.err == 0 && event.u.get_report_reply.size >= 4U
-        ) {
-          const auto crc_offset = static_cast<std::size_t>(event.u.get_report_reply.size) - 4U;
-          const auto crc = crc32(
-            std::span<const std::uint8_t> {event.u.get_report_reply.data, crc_offset},
-            playstation_crc_seed(ps::playstation_feature_crc_seed)
-          );
-          write_u32_le(event.u.get_report_reply.data + crc_offset, crc);
-        }
-
         static_cast<void>(write_event(event));
       }
 
